# Copy to secrets.env (gitignored). Applied to K8s once via deploy/apply-secrets.sh.
# Pods read these from secrets — not from this file at runtime.
#
# MADEYE_BASE_URL is not a secret — host only (no /v1); set on madeye-proxy Deployment env
# (see .env.example and deploy/madeye-proxy.yaml).

GENAXIS_API_KEY=replace-with-genaxis-api-key
MADEYE_API_KEY=replace-with-madeye-bearer-token
